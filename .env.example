# Spotify app from developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Polling
POLL_INTERVAL=20s
MIN_PROGRESS=10s
IDLE_AFTER=60s
RESET_ON_EXIT=true
LOG_LEVEL=info

# Bio mode: app credentials from my.telegram.org
TG_API_ID=
TG_API_HASH=
TG_PHONE=
BIO_FORMAT=🎧 {artist} — {title}
BIO_MAX_LEN=70
# Bio shown when nothing plays; empty = your bio at tg-login time
BIO_DEFAULT=

# Channel mode: bot from @BotFather, added to the channel as admin
TG_BOT_TOKEN=
TG_CHANNEL=@your_channel
CHANNEL_STRATEGY=edit
CHANNEL_PIN=true
CHANNEL_IDLE_TEXT=⏸ Not listening right now
